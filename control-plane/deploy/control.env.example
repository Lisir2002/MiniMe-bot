MINIBOT_HOST=127.0.0.1
MINIBOT_PORT=8787
MINIBOT_DB_URL=jdbc:postgresql://127.0.0.1:5432/minibot
MINIBOT_DB_USER=minibot
MINIBOT_DB_PASSWORD=change-me
MINIBOT_SERVER_NAME=Mini-AIBOT Cloud
MINIBOT_TIMEZONE=Asia/Shanghai
MINIBOT_DATA_DIR=/var/lib/minibot
MINIBOT_MASTER_KEY_PATH=/var/lib/minibot/master.key
MINIBOT_BOOTSTRAP_TOKEN_FILE=/var/lib/minibot/bootstrap.token
MINIBOT_PAIRING_TTL_SECONDS=3600
MINIBOT_DOCKER_HOST=unix:///var/run/docker.sock

# Optional private registry authentication. Credentials are only sent to
# image references whose registry host matches MINIBOT_REGISTRY_HOST.
# MINIBOT_REGISTRY_HOST=ghcr.io
# MINIBOT_REGISTRY_USERNAME=your-user
# MINIBOT_REGISTRY_TOKEN=read-packages-token

# Access mode: "ip" (plain HTTP test) or "domain" (Caddy + HTTPS).
MINIBOT_ACCESS_MODE=ip
# Set these only in domain mode.
MINIBOT_PUBLIC_URL=
MINIBOT_DOMAIN=
# Optional ACME account email used by Caddy.
MINIBOT_ACME_EMAIL=
