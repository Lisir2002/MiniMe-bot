{
  "name": "@jieapi/plugin-sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK for building Mini-AIBOT plugins",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./page": {
      "types": "./types/minibot.d.ts"
    },
    "./page/vue": {
      "types": "./types/minibot-vue.d.ts"
    }
  },
  "files": [
    "dist",
    "types",
    "LICENSE"
  ],
  "engines": {
    "node": ">=12"
  },
  "keywords": [
    "minibot",
    "plugin",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jieapi/AiCode.git",
    "directory": "plugins/sdk"
  },
  "homepage": "https://github.com/jieapi/AiCode/tree/main/plugins/sdk",
  "bugs": {
    "url": "https://github.com/jieapi/AiCode/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  }
}
